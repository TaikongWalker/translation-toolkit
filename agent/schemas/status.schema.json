{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "status.py report",
  "type": "object",
  "required": ["ok", "exit_code", "project", "units", "terms", "chapters", "blocking"],
  "properties": {
    "ok": {"type": "boolean"},
    "exit_code": {"type": "integer", "enum": [0, 1]},
    "project": {
      "type": "object",
      "properties": {
        "slug": {"type": "string"},
        "title": {"type": "string"},
        "author": {"type": "string"},
        "translator": {"type": "string"},
        "style_id": {"type": "string"},
        "version": {"type": "string"},
        "rights": {"type": "string"},
        "publisher": {"type": "string"}
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {"type": "string"},
          "file": {"type": "string"},
          "status": {"type": "string"},
          "zh_chars": {"type": "string"},
          "todo": {"type": "string"},
          "updated": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "terms": {
      "type": "object",
      "required": ["total", "final", "draft"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "final": {"type": "integer", "minimum": 0},
        "draft": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    },
    "chapters": {
      "type": "object",
      "required": ["count", "todos", "files"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "todos": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {"type": "string"},
              "todos": {"type": "integer"},
              "chars": {"type": "integer"}
            }
          }
        }
      }
    },
    "blocking": {"type": "array", "items": {"type": "string"}},
    "check": {"type": ["object", "null"]},
    "global": {"type": ["object", "null"]}
  }
}
